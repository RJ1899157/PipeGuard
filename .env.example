# Copy using scripts/init_local_env.py; generated credentials remain local.
POSTGRES_PASSWORD=replace_with_random_admin_password
PIPEGUARD_OWNER_PASSWORD=replace_with_random_owner_password
PIPEGUARD_POSTGRES_PORT=55432
PIPEGUARD_DATABASE_URL=postgresql+psycopg://pipeguard_owner:replace_with_random_owner_password@127.0.0.1:55432/pipeguard
# Added privately by scripts/configure_api.py after migrations.
PIPEGUARD_API_PASSWORD=replace_with_generated_runtime_password
PIPEGUARD_API_DATABASE_URL=postgresql+psycopg://pipeguard_api:replace_with_generated_runtime_password@127.0.0.1:55432/pipeguard
PIPEGUARD_ADMIN_TOKEN=replace_with_generated_administrator_token
# Added privately by scripts/configure_watchdog.py; runtime URL lives in .env.watchdog.
PIPEGUARD_WATCHDOG_PASSWORD=replace_with_generated_read_only_watchdog_password
# Optional hosted investigation; keep this organization on Groq's Free plan.
GROQ_API_KEY=replace_with_private_groq_key
# Enable only after the operator confirms the Groq organization is on Free.
PIPEGUARD_INVESTIGATION_ENABLED=false
